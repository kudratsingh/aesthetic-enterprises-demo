# Copy to api/.env for local overrides. Defaults already work with `make dev`.
# Never commit .env (gitignored). Secrets are never logged.

# App role (non-superuser so RLS applies — ADR-0002)
DATABASE_URL=postgresql+asyncpg://cnos_app:cnos_app@localhost:5433/cnos
# Admin/owner role, DDL only (alembic); unset in single-role setups like Neon
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://cnos:cnos@localhost:5433/cnos
JWT_SECRET=dev-only-secret-change-me-not-for-production
# HMAC shared secret for /api/v1/webhooks/ghl (ADR-0005); unset → endpoint answers 503
# GHL_WEBHOOK_SECRET=dev-only-webhook-secret
# Payment provider implementation (ADR-0010); "mock" is the only one shipped
# PAYMENT_PROVIDER=mock
# HMAC shared secret for /api/v1/webhooks/payments (ADR-0010); unset → endpoint answers 503
# PAYMENT_WEBHOOK_SECRET=dev-only-payment-secret
ENVIRONMENT=dev
# CORS_ORIGINS=["http://localhost:5173"]

# Web (build-time, deployed environments only — local dev uses the Vite proxy):
# VITE_API_URL=https://api.example.com
