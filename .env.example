# Copy to api/.env for local overrides. Defaults already work with `make dev`.
# Never commit .env (gitignored). Secrets are never logged.

DATABASE_URL=postgresql+asyncpg://cnos:cnos@localhost:5433/cnos
JWT_SECRET=dev-only-secret-change-me-not-for-production
ENVIRONMENT=dev
# CORS_ORIGINS=["http://localhost:5173"]

# Web (build-time, deployed environments only — local dev uses the Vite proxy):
# VITE_API_URL=https://api.example.com
